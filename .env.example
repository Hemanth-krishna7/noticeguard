# ==============================================================================
# NoticeGuard Environment Configuration Example
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Render / Local Node Server)
# ------------------------------------------------------------------------------
# Port the server listens on (Render automatically injects PORT=10000 or similar)
PORT=5000

# Environment mode ('development' or 'production')
NODE_ENV=production

# Allowed frontend origins for CORS (comma-separated or single domain)
# Examples:
#   Local: http://localhost:5173
#   Render/Vercel: https://your-noticeguard-app.vercel.app
#   Wildcard (dev/demo): *
CORS_ORIGIN=https://your-noticeguard-app.vercel.app

# ------------------------------------------------------------------------------
# Frontend Configuration (Vercel / Local Vite)
# ------------------------------------------------------------------------------
# Full URL to deployed backend service.
# - In local development: Leave blank or omit to use Vite's built-in /api proxy.
# - On Vercel: Set to your public Render backend URL (e.g. https://noticeguard-api.onrender.com).
VITE_API_URL=https://your-noticeguard-api.onrender.com
